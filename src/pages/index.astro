---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="PlayJS - Browser Terminal + Code Playground">
  <div class="landing-page">
    <div class="hero">
      <div class="logo">
        <span class="logo-bracket">&lt;</span>
        <span class="logo-text">PlayJS</span>
        <span class="logo-bracket">/&gt;</span>
      </div>
      <h1 class="tagline neon-glow">Type. Run. Experiment. All in the Browser.</h1>
      <p class="description">
        A developer-focused browser app that combines a terminal emulator with a live code playground.
        Execute JavaScript, experiment with HTML/CSS, and see instant results.
      </p>
      <div class="cta-buttons">
        <a href="/terminal" class="cta-primary">Launch PlayJS</a>
        <a href="/about" class="cta-secondary">Learn More</a>
      </div>
    </div>

    <div class="features">
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Terminal Emulator</h3>
        <p>Full-featured terminal with command history, custom commands, and a sleek dark theme.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🎨</div>
        <h3>Code Playground</h3>
        <p>Write HTML, CSS, and JavaScript with syntax highlighting and live preview.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💾</div>
        <h3>Save & Load</h3>
        <p>Store your code snippets locally and load them anytime with simple commands.</p>
      </div>
    </div>

    <div class="demo-section">
      <h2>Quick Start</h2>
      <div class="command-examples">
        <div class="command-example">
          <code>$ help</code>
          <span class="command-desc">List all available commands</span>
        </div>
        <div class="command-example">
          <code>$ run preview</code>
          <span class="command-desc">Execute your code and see results</span>
        </div>
        <div class="command-example">
          <code>$ save myproject</code>
          <span class="command-desc">Save your current code</span>
        </div>
        <div class="command-example">
          <code>$ load myproject</code>
          <span class="command-desc">Load a saved snippet</span>
        </div>
      </div>
    </div>

    <footer class="landing-footer">
      <p>Built with Astro + Svelte | Powered by CodeMirror & xterm.js</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .landing-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, #0F111A 0%, #1a1d29 100%);
  }

  .logo {
    font-size: 4rem;
    font-weight: bold;
    margin-bottom: 1rem;
  }

  .logo-bracket {
    color: #00FFA3;
  }

  .logo-text {
    color: #E0E0E0;
    margin: 0 0.5rem;
  }

  .tagline {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: #00FFA3;
  }

  .description {
    font-size: 1.1rem;
    color: #9CA3AF;
    max-width: 600px;
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-primary,
  .cta-secondary {
    padding: 1rem 2rem;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.3s;
    text-decoration: none;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
  }

  .cta-primary {
    background-color: #00FFA3;
    color: #0F111A;
    border: 2px solid #00FFA3;
  }

  .cta-primary:hover {
    background-color: transparent;
    color: #00FFA3;
    box-shadow: 0 0 20px rgba(0, 255, 163, 0.5);
  }

  .cta-secondary {
    background-color: transparent;
    color: #00FFA3;
    border: 2px solid #00FFA3;
  }

  .cta-secondary:hover {
    background-color: #00FFA3;
    color: #0F111A;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    padding: 4rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .feature-card {
    background-color: #1a1d29;
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid transparent;
    transition: all 0.3s;
    text-align: center;
  }

  .feature-card:hover {
    border-color: #00FFA3;
    box-shadow: 0 0 30px rgba(0, 255, 163, 0.2);
    transform: translateY(-5px);
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    color: #00FFA3;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .feature-card p {
    color: #9CA3AF;
    line-height: 1.6;
  }

  .demo-section {
    padding: 4rem 2rem;
    background-color: #0D0F16;
    text-align: center;
  }

  .demo-section h2 {
    color: #00FFA3;
    font-size: 2rem;
    margin-bottom: 2rem;
  }

  .command-examples {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
  }

  .command-example {
    background-color: #1a1d29;
    padding: 1.5rem;
    border-radius: 8px;
    border-left: 4px solid #00FFA3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .command-example code {
    color: #00FFA3;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .command-desc {
    color: #9CA3AF;
    font-size: 0.9rem;
  }

  .landing-footer {
    padding: 2rem;
    text-align: center;
    background-color: #1a1d29;
    border-top: 2px solid #00FFA3;
    color: #9CA3AF;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .logo {
      font-size: 2.5rem;
    }

    .tagline {
      font-size: 1.5rem;
    }

    .description {
      font-size: 1rem;
    }

    .cta-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }

    .command-example {
      flex-direction: column;
      text-align: left;
      align-items: flex-start;
    }

    .features {
      grid-template-columns: 1fr;
    }
  }
</style>
